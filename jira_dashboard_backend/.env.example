# Copy this file to ".env" in the same directory (jira_dashboard_backend/) and fill in real values.
# settings.py loads it via python-dotenv.

# --- Django ---
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True

# --- Jira Cloud ---
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token
PROJECT_KEY=SCRUM
JIRA_MAX_RESULTS=50
# The sub-task issue type name in your project ("Subtask" or "Sub-task")
JIRA_SUBTASK_ISSUE_TYPE=Subtask

# --- Google Gemini (Gemini Developer API) ---
# Get keys at https://aistudio.google.com/apikey . A second key is optional (used for rotation).
GEMINI_API_KEY1=your_first_gemini_key
GEMINI_API_KEY2=your_second_gemini_key
GEMINI_MODEL=gemini-2.5-flash
